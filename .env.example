# Copy to .env and fill in. Do not commit .env.

# Base URL of a server that implements POST /v1/systemone.
#   Jev (hosted):     https://api.typesafe.ai
#   Laya (local):     http://127.0.0.1:8000   (run: laya-serve)
MAGIC8_BASE_URL=https://api.typesafe.ai

# Bearer token. Needed for Jev. Optional for local Laya.
MAGIC8_API_KEY=

# Model name sent in the request.
MAGIC8_MODEL=jev-latest

# Request timeout in milliseconds.
MAGIC8_TIMEOUT_MS=5000
