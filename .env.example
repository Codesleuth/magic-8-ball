# Copy to .env and fill in. Do not commit .env.

# Base URL of a server that implements POST /v1/systemone.
#   Laya (local, default): http://127.0.0.1:8000   (run: laya-serve)
#   Jev (hosted):          https://api.typesafe.ai
MAGIC8_BASE_URL=http://127.0.0.1:8000

# Bearer token. Needed for Jev. Only needed for Laya if the server sets LAYA_API_KEY.
MAGIC8_API_KEY=

# Model name sent in the request. Leave empty for Laya (the server picks).
# For Jev: jev-latest
MAGIC8_MODEL=

# Request timeout in milliseconds.
MAGIC8_TIMEOUT_MS=5000
